# Copiar a .env  (PowerShell: Copy-Item env.example .env)
#
# --- Opción gratis: Google AI Studio (Gemini) ---
# Sacá la clave en https://aistudio.google.com/apikey y descomentá estas tres líneas.
# Usá gemini-2.5-flash: soporta function calling en el endpoint compatible con OpenAI.
# (Evitar gemini-3-flash-preview: tiene un bug conocido de 400 intermitente con tools.)
# LLM_API_KEY=tu-clave-de-ai-studio
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash
#
# --- Opción gratis: Groq ---
# LLM_API_KEY=tu-clave-de-groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# --- Cualquier proveedor compatible con la API de OpenAI (OpenAI, Azure, Mistral, local) ---
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Puerto del servidor
PORT=3000
